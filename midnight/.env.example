# Nightpass on Midnight
#
# Copy to midnight/.env and fill in. Every value has a working default except
# the seed, which is generated on first run and written to
# midnight/cli/.nightpass/seed.<network>.txt if you leave it blank.
#
#   cp midnight/.env.example midnight/.env

# ── which network ───────────────────────────────────────────────────────────
# "preview" or "preprod". Both are public Midnight test networks and both
# satisfy the deploy requirement. Preview is the default.
NIGHTPASS_NETWORK=preview

# ── the deployer / agent wallet ─────────────────────────────────────────────
# 32-byte hex seed. Leave blank to have one generated and saved locally.
# This owns the deployment and holds the tNIGHT that pays for transactions,
# so treat it like a private key: midnight/.env is gitignored for that reason.
NIGHTPASS_SEED=

# ── the deployed contract ───────────────────────────────────────────────────
# Set after "pnpm nightpass:deploy" writes it, or paste an existing address to
# point the CLI and the web app at a contract someone else deployed.
# Overrides midnight/deployment.json when present.
NIGHTPASS_CONTRACT=

# ── infrastructure ──────────────────────────────────────────────────────────
# The proof server runs locally in Docker and never leaves your machine.
# Proving is what keeps the witness data private, so this is deliberately not
# a hosted service.
NIGHTPASS_PROOF_SERVER=http://127.0.0.1:6300

# Public read-only infrastructure. Override only to point at your own node.
# Defaults are derived from NIGHTPASS_NETWORK, so leave these blank normally.
NIGHTPASS_INDEXER=
NIGHTPASS_INDEXER_WS=
NIGHTPASS_NODE=

# ── logging ─────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error. SDK output goes to midnight/cli/logs.
DEBUG_LEVEL=info
