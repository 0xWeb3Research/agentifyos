# deps
node_modules/
.pnpm-store/

# next
.next/
out/
next-env.d.ts

# build
dist/
build/
*.tsbuildinfo

# env & keys
.env
.env.local
.env.*.local
keys/
*.pem

# prisma
prisma/*.db

# playwright
test-results/
playwright-report/
.playwright/

# os / editor
.DS_Store
*.log

# Rust contract build output
contracts/*/target/

# Submission workspace: deck, form answers, evaluator notes. Tracked, because
# an evaluator reading the repo should be able to find the same claims the
# submission makes and check them against the code. It holds no secrets, only
# the names of the variables a deployment needs.

# Agent transcripts dumped into the repo root while pairing.
claude-session.jsonl
codex-session.jsonl

# Security-scan artifacts — kept local, never committed.
# .deepsec/ is a self-contained tool (its own node_modules); security-findings/
# is a categorized vulnerability map that must not ship in a repo that may go
# public. Address findings in code; don't publish the map.
.deepsec/
security-findings/

# Midnight / Nightpass
midnight/*/.nightpass/
midnight/*/logs/
# The generated contract artifacts are committed on purpose. The deployed site
# proves circuits server-side for the live demo, which needs the prover keys
# (20M) and the zkir, so a deploy has to be self-contained. None of it is
# secret: the verifier keys are already public on-chain.
midnight/contract/dist/
midnight/.env
# The encrypted private state store: pass secrets and nonces live here.
midnight/*/midnight-level-db/

# The global `keys/` rule above exists for private signing keys. Midnight's ZK
# proving keys are not secret (their verifiers are already public on-chain) and
# the deployed site needs them to prove circuits for the live demo, so this one
# directory is exempt.
!midnight/contract/src/managed/nightpass/keys/
