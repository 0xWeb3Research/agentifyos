# deps
node_modules/
.pnpm-store/

# next
.next/
out/
next-env.d.ts

# build
dist/
build/
*.tsbuildinfo

# env & keys
.env
.env.local
.env.*.local
keys/
*.pem

# prisma
prisma/*.db

# playwright
test-results/
playwright-report/
.playwright/

# os / editor
.DS_Store
*.log

# Rust contract build output
contracts/*/target/

# Submission workspace: deck, form answers, evaluator notes. Tracked, because
# an evaluator reading the repo should be able to find the same claims the
# submission makes and check them against the code. It holds no secrets, only
# the names of the variables a deployment needs.

# Agent transcripts dumped into the repo root while pairing.
claude-session.jsonl
codex-session.jsonl

# Security-scan artifacts — kept local, never committed.
# .deepsec/ is a self-contained tool (its own node_modules); security-findings/
# is a categorized vulnerability map that must not ship in a repo that may go
# public. Address findings in code; don't publish the map.
.deepsec/
security-findings/

# Midnight / Nightpass
midnight/*/.nightpass/
midnight/*/logs/
# The generated decoder (152K) is committed: the deployed site needs it to read
# public contract state, and it carries no secrets. The proving keys are 20M and
# are regenerated with `pnpm nightpass:compile`.
midnight/contract/src/managed/nightpass/keys/
midnight/contract/src/managed/nightpass/zkir/
midnight/contract/dist/
midnight/.env
# The encrypted private state store: pass secrets and nonces live here.
midnight/*/midnight-level-db/
