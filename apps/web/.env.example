# ── AgentifyOS · Algorand testnet (REAL settlement) ──────────────────────────
# Copy to .env  →  cp .env.example .env
# Then run `pnpm algo:keygen` and paste the printed lines below.
# Sensible defaults are baked into the code, so most of this is optional.
#
# Full runbook: docs/ALGORAND.md

MODE=real
CHAIN=algorand
WEB_PORT=8402

# ── Algorand testnet ─────────────────────────────────────────────────────────
ALGOD_TESTNET_URL=https://testnet-api.algonode.cloud
ALGO_USDC_ASSET_ID=10458941

# The hosted x402 facilitator. It verifies every payment, submits it, and
# sponsors the network fee, which is why a buying agent spends no ALGO.
# No API key, no signup: GET /supported to see what it serves.
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz

# ── Keys ─────────────────────────────────────────────────────────────────────
# 25-word mnemonics from `pnpm algo:keygen`. NEVER commit them. There is no
# facilitator key: GoPlausible runs that half.
#
# Both accounts need ~0.3 testnet ALGO (https://lora.algokit.io/testnet/fund)
# and must opt into USDC (`pnpm algo:optin`). Stock the treasury with USDC from
# https://faucet.circle.com (pick Algorand → TestNet), then `pnpm algo:fund --usdc 1`.
ALGO_TREASURY_MNEMONIC=
ALGO_AGENT_MNEMONIC=

# Public addresses (safe to share). ALGO_TREASURY_ADDRESS is the payee every
# listing quotes; without it the paid endpoints answer 503 rather than quote a
# price nobody can pay.
ALGO_TREASURY_ADDRESS=
ALGO_AGENT_ADDRESS=

# Surfaced to the browser bundle so the UI names the same chain the server
# settles on. Mirror the three values above.
NEXT_PUBLIC_CHAIN=algorand
NEXT_PUBLIC_ALGO_TREASURY_ADDRESS=
NEXT_PUBLIC_ALGO_AGENT_ADDRESS=

# ── Casper testnet (only when CHAIN=casper) ──────────────────────────────────
# The original settlement path, kept selectable. See docs/TESTNET.md.
# CHAIN=casper
# CSPR_NETWORK=casper:casper-test
# CSPR_NODE_RPC=https://node.testnet.casper.network/rpc
# WCSPR_PACKAGE_HASH=3d80df21ba4ee4d66a2a1f60c32570dd5685e4b279f6538162a5fd1314847c1e
# WCSPR_BALANCES_UREF=uref-f8491246e0eed9c5cd5c0a896dc6e0a270bba846df69b6d497c9694dcdc2770c-007
# CSPR_KEY_ALGO=ed25519
# FACILITATOR_KEY_PEM=./keys/facilitator.pem
# AGENT_KEY_PEM=./keys/agent.pem
# TREASURY_KEY_PEM=./keys/treasury.pem
# FACILITATOR_PUBLIC_KEY=
# FACILITATOR_ACCOUNT_HASH=
# AGENT_PUBLIC_KEY=
# AGENT_ACCOUNT_HASH=
# TREASURY_PUBLIC_KEY=
# TREASURY_ACCOUNT_HASH=
# FACILITATOR_GAS_MOTES=4000000000
# WRAP_GAS_MOTES=20000000000

# ── Optional: Postgres persistence ───────────────────────────────────────────
# USE_DB=1
# DATABASE_URL=postgresql://agentifyos:agentifyos@localhost:5404/agentifyos?schema=public

# ── Ledger persistence ───────────────────────────────────────────────────────
# Real settlements survive restarts when this is set. Railway injects it
# automatically; locally use `pnpm db:up` (redis on 6404). Unset = in-memory.
# REDIS_URL=redis://localhost:6404

# ── Demo film ────────────────────────────────────────────────────────────────
# The landing page streams a recorded demo run from a private object bucket.
# /api/demo-video mints a short-lived presigned URL and redirects, so the bytes
# never pass through this service. Unset = the player 404s and nothing else
# breaks.
#
# There is one film per network, rendered from video/ in the parent repo, and the
# route picks by the visitor's network. DEMO_BUCKET_OBJECT is the fallback for a
# network with no film of its own.
# DEMO_BUCKET_ENDPOINT=https://t3.storageapi.dev
# DEMO_BUCKET_NAME=
# DEMO_BUCKET_KEY_ID=
# DEMO_BUCKET_SECRET=
# DEMO_BUCKET_OBJECT=agentifyos-demo.mp4
# DEMO_BUCKET_OBJECT_ALGORAND=agentifyos-demo-algorand.mp4
# DEMO_BUCKET_OBJECT_CASPER=agentifyos-demo-casper.mp4
# DEMO_BUCKET_OBJECT_MIDNIGHT=agentifyos-demo-midnight.mp4

# Public origin. Used for canonicals, sitemap, OG images, and JSON-LD.
# Railway sets RAILWAY_PUBLIC_DOMAIN, which takes over if this is unset.
NEXT_PUBLIC_SITE_URL=https://agentifyos.xyz

# Signs wallet session cookies. REQUIRED in production: the app refuses to
# start without it. Also required whenever MODE=real. Generate with:
# openssl rand -base64 48
AUTH_SECRET=

# ── Spend safety (server-wallet protection) ──────────────────────────────────
# Hard cap (USD) on any single server-initiated agent run or MCP call_tool. A
# client-supplied budget can only lower this, never raise it. Default 0.10.
AGENT_MAX_SPEND_USD=0.1

# Open public demo: let anonymous visitors trigger a run that spends from the
# server wallet. Off by default. When on, DEMO_DAILY_USD_CAP bounds the damage.
ALLOW_UNAUTH_SPEND=0
DEMO_DAILY_USD_CAP=2

# Secret seed for the RWA-attestor notary signing key. Without it, a fresh random
# key is generated per process (attestations won't verify across restarts). Set a
# stable value in production so attestation signatures remain verifiable, and keep
# it secret: anyone who knows it can forge attestations.
# NOTARY_SEED=
