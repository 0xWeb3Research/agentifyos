# ── AgentifyOS · Casper testnet (REAL settlement) ────────────────────────────
# Copy to .env  →  cp .env.example .env
# Then run `pnpm casper:keygen` and paste the printed identities below.
# Sensible defaults are baked into the code, so most of this is optional.

MODE=real
WEB_PORT=8402

# ── Casper testnet ───────────────────────────────────────────────────────────
CSPR_NETWORK=casper:casper-test
CSPR_CHAIN_NAME=casper-test
CSPR_NODE_RPC=https://node.testnet.casper.network/rpc
CSPR_EXPLORER=https://testnet.cspr.live

# ── WCSPR — the x402-enabled CEP-18 that payments settle in ──────────────────
# package 3d80df21… (active version 7 → contract-4b351800…f67b3e)
WCSPR_PACKAGE_HASH=3d80df21ba4ee4d66a2a1f60c32570dd5685e4b279f6538162a5fd1314847c1e
WCSPR_DECIMALS=9
# seed URef of the contract's `balances` dictionary (used for read-only balances)
WCSPR_BALANCES_UREF=uref-f8491246e0eed9c5cd5c0a896dc6e0a270bba846df69b6d497c9694dcdc2770c-007

# ── Keys ─────────────────────────────────────────────────────────────────────
# PEM files live in apps/web/keys/ — gitignored. NEVER commit them.
CSPR_KEY_ALGO=ed25519
FACILITATOR_KEY_PEM=./keys/facilitator.pem
AGENT_KEY_PEM=./keys/agent.pem
TREASURY_KEY_PEM=./keys/treasury.pem

# Public identities (safe to share). Fill from `pnpm casper:keygen`.
# Fund FACILITATOR (gas) and TREASURY (wrapping) via the faucet — see docs/TESTNET.md §2.
FACILITATOR_PUBLIC_KEY=
FACILITATOR_ACCOUNT_HASH=
AGENT_PUBLIC_KEY=
AGENT_ACCOUNT_HASH=
TREASURY_PUBLIC_KEY=
TREASURY_ACCOUNT_HASH=

# ── Gas budgets (motes) ──────────────────────────────────────────────────────
FACILITATOR_GAS_MOTES=7000000000     # ~7 CSPR per settlement
WRAP_GAS_MOTES=20000000000           # ~20 CSPR for the 184KB proxy_caller session

# ── Optional: hosted facilitator ─────────────────────────────────────────────
# We SELF-HOST (own key + public RPC, no quota). The hosted one is free-tier
# capped at 25 testnet calls/day (~12 payments).
# CSPR_CLOUD_API_KEY=
# X402_FACILITATOR_URL=https://x402-facilitator.cspr.cloud

# ── Optional: Postgres persistence ───────────────────────────────────────────
# USE_DB=1
# DATABASE_URL=postgresql://agentifyos:agentifyos@localhost:5404/agentifyos?schema=public

# ── Ledger persistence ───────────────────────────────────────────────────────
# Real settlements survive restarts when this is set. Railway injects it
# automatically; locally use `pnpm db:up` (redis on 6404). Unset = in-memory.
# REDIS_URL=redis://localhost:6404
