# The canonical environment file lives in the web app, where Next.js and the
# chain CLI scripts actually read it:
#
#     apps/web/.env.example   → copy to → apps/web/.env
#
#     cd apps/web && cp .env.example .env && pnpm algo:keygen
#
# See docs/ALGORAND.md for the full setup (accounts, faucets, opt-in, settling).
# For the Casper path instead, see docs/TESTNET.md.
#
# Only docker-compose reads anything from this directory, and it has its own
# defaults baked in (Postgres on port 5404); no env needed to run `pnpm db:up`.

# ── the live Nightpass demo on /shielded ────────────────────────────────────
# A visitor drives a funded agent on Midnight from the page. Leave the seed
# unset and the live run turns itself off; the verification steps still work.
NIGHTPASS_NETWORK=preview
NIGHTPASS_SEED=
NIGHTPASS_PROOF_SERVER=http://127.0.0.1:6300
# Overrides midnight/deployment.json when set.
NIGHTPASS_CONTRACT=

# ── daily demo allowance, per chain ─────────────────────────────────────────
# Rate limiting caps how FAST one client spends; this caps how much the funded
# wallets can lose in a day. Set to false to run uncapped, which is reasonable
# privately and reckless on a public deployment. Anything but "false" keeps it
# on, so a typo fails closed.
DEMO_SPEND_LIMIT_ENABLED=true
DEMO_DAILY_CAP_ALGORAND_USD=2
DEMO_DAILY_CAP_CASPER_USD=2
# Midnight is metered in transactions: DUST regenerates and has no price.
DEMO_DAILY_CAP_MIDNIGHT_TX=60
