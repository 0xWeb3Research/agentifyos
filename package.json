{
  "name": "agentifyos",
  "private": true,
  "version": "0.1.0",
  "description": "AgentifyOS: Apify for AI agents, settled with x402 on Casper. The marketplace where autonomous agents discover, pay for, and use tools.",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "pnpm --filter @agentifyos/web dev",
    "build": "pnpm --filter @agentifyos/web build",
    "start": "pnpm --filter @agentifyos/web start",
    "lint": "pnpm --filter @agentifyos/web lint",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "selftest": "pnpm --filter @agentifyos/web selftest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @agentifyos/web db:push",
    "db:seed": "pnpm --filter @agentifyos/web db:seed",
    "test:e2e": "pnpm --filter @agentifyos/web test:e2e",
    "nightpass:compile": "pnpm --filter @nightpass/contract compact && pnpm --filter @nightpass/contract build",
    "nightpass:test": "pnpm --filter @nightpass/contract test",
    "nightpass:proof": "pnpm --filter @nightpass/cli proof-server:up",
    "nightpass:proof:down": "pnpm --filter @nightpass/cli proof-server:down",
    "nightpass:deploy": "pnpm --filter @nightpass/cli deploy",
    "nightpass:demo": "pnpm --filter @nightpass/cli demo",
    "nightpass:state": "pnpm --filter @nightpass/cli state"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
    }
  }
}
